        "## PUNTO 3 Obtener datos del Banco Mundial para Brasil (2010-2023)\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "b4c6cee1",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 271
        },
        "outputId": "e177c1e6-0255-482e-d1df-03f9137a5412"
      },
      "source": [
        "import wbgapi as wb\n",
        "import pandas as pd\n",
        "\n",
        "country_brazil = ['BRA']\n",
        "years_brazil = range(2010, 2024)\n",
        "\n",
        "# Define los indicadores de Brasil con sus códigos del Banco Mundial\n",
        "indicators_brazil = {\n",
        "    'NY.GDP.MKTP.KD.ZG': 'GDP Growth (annual %)',\n",
        "    'NY.GDP.PCAP.PP.CD': 'GDP per capita, PPP (current international $)',\n",
        "    'FP.CPI.TOTL.ZG': 'Inflation, consumer prices (annual %)',\n",
        "    'SL.UEM.TOTL.ZS': 'Unemployment, total (% of total labor force) (modeled ILO estimate)',\n",
        "    'SP.POP.TOTL': 'Population, total'\n",
        "}\n",
        "\n",
        "df_brazil = pd.DataFrame()\n",
        "\n",
        "for indicator_code, indicator_name in indicators_brazil.items():\n",
        "    df_temp = wb.data.DataFrame(indicator_code, economy=country_brazil, time=years_brazil, labels=True)\n",
        "\n",
        "    df_temp = df_temp.rename(columns={col: indicator_name + ' - ' + col for col in df_temp.columns if col.startswith('YR')})\n",
        "    df_temp = df_temp.reset_index()\n",
        "    df_temp = df_temp.set_index('economy')\n",
        "\n",
        "    if df_brazil.empty:\n",
        "        df_brazil = df_temp\n",
        "    else:\n",
        "\n",
        "        df_brazil = pd.concat([df_brazil, df_temp], axis=1)\n",
        "\n",
        "df_brazil = df_brazil.loc[:,~df_brazil.columns.duplicated()]\n",
        "\n",
        "indicadores_español = {\n",
        "    'GDP Growth (annual %)': 'Crecimiento PIB (anual %)',\n",
        "    'GDP per capita, PPP (current international $)': 'PIB per cápita, PPA (USD internacionales actuales)',\n",
        "    'Inflation, consumer prices (annual %)': 'Inflación, precios al consumidor (anual %)',\n",
        "    'Unemployment, total (% of total labor force) (modeled ILO estimate)': 'Desempleo, total (% de la fuerza laboral total) (estimación OIT modelada)',\n",
        "    'Population, total': 'Población, total'\n",
        "}\n",
        "\n",
        "new_columns = {}\n",
        "for col in df_brazil.columns:\n",
        "    new_col = col\n",
        "    for eng_name, esp_name in indicadores_español.items():\n",
        "        if eng_name in col:\n",
        "            new_col = col.replace(eng_name, esp_name)\n",
        "            break\n",
        "    new_columns[col] = new_col\n",
        "\n",
        "df_brazil = df_brazil.rename(columns=new_columns)\n",
        "\n",
        "display(df_brazil.head())"
      ],
